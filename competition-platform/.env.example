# Server only. Copy these entries to the ignored .env; preserve existing DB/JWT settings.
LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_ASSISTANT_TIMEOUT_SECONDS=120
LLM_ASSISTANT_MAX_TOKENS=1200
ADVICE_TURN_TIMEOUT_SECONDS=90
# Ollama: LLM_PROVIDER=ollama; LLM_MODEL=deepseek-r1:7b
# Local URL: http://localhost:11434; Docker URL: http://host.docker.internal:11434
